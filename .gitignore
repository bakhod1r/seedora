# The built binaries, anchored to the repository root. Without the leading slash
# these patterns also match the cmd/seedora/ and tools/pages/ directories, which
# would keep the source out of the repository.
/seedora
/pages
/bin/

# Scratch database and config produced by `make demo` and `make dev`.
/tmp/

/coverage.out

# A developer's own database and mapping. seedora.yaml is meant to be committed
# by the projects that use Seedora, but not by Seedora itself.
/seedora.yaml
*.db
*.sqlite
*.sqlite3

# The browser tests are the one part of this project with a Python toolchain,
# and it leaves bytecode and a virtualenv behind. Neither belongs here: the
# cache is rewritten on every run and would churn in every diff, and the
# interpreter version is baked into its filename.
__pycache__/
*.py[cod]
/.venv/

# The subagent-driven workspace: ledgers, briefs, and review packages, which are
# scratch for a plan in progress rather than a record of it. Git history is the
# record.
/.superpowers/

# oneenv reads these, and they are where a DSN with a password lives.
.env
.env.*
!.env.example
